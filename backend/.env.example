APP_NAME=Repelect API
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://repelect:repelect@localhost:5432/repelect
FRONTEND_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
AUTH_SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace-this-before-running-bootstrap
